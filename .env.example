# Set this to the NAS's verified LOCAL Linux storage path, never a Windows SMB drive.
DATA_ROOT=./runtime
PUID=10001
PGID=10001
# Loopback is the safe default. Set to the NAS's private LAN/VPN IP for remote agents.
BIND_ADDRESS=127.0.0.1
HTTPS_PORT=8443
CONTEXT_HOST=context.nas.internal
MAX_CONTEXT_TOKENS=2000
BACKUP_KEEP=14
